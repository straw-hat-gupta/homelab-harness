# Copy to .env and fill in. Every variable is described in docs/configuration.md.

# --- Django (required) ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000

# --- PostgreSQL (required) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Database password (the name is inherited from the Supabase-hosted setup).
SUPABASE_DB_PW=replace-with-your-db-password
POSTGRES_SSLMODE=require

# --- Authentication: Supabase-issued JWTs (required for now) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# --- Redis / Celery (optional; Docker Compose points these at its redis service) ---
REDIS_URL=
CELERY_BROKER_URL=

# --- Credential encryption (required to connect any integration) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_ALLOW_PLAINTEXT_FALLBACK=false

# --- LLM (required) ---
OPENAI_KEY=replace-with-your-openai-key
PLANNER_MODEL=gpt-4o-mini
PROCESSING_LLM_MODEL=gpt-4o-mini

# --- Integrations ---
# Google (required by settings; used by Gmail, Calendar, Contacts, Drive)
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Microsoft (optional; Outlook Mail and Outlook Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Notion (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
PLUGIN_OAUTH_SUCCESS_REDIRECT=aiva://oauth/{plugin}/success
PLUGIN_OAUTH_FAILURE_REDIRECT=aiva://oauth/{plugin}/failure

# --- Built-in tool API keys (optional; the matching tools fail without them) ---
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# --- Tuning (optional; values shown are the defaults) ---
PLANNER_TIMEOUT=60
PROCESSING_LLM_TIMEOUT=60
PROCESSING_LLM_MAX_TOKENS=1024
TOOL_STEP_TIMEOUT=60
PLAN_CACHE_TTL=3600
AGENT_THROTTLE_RATE=20/min
AGENT_MAX_MODIFY_REVISIONS=5
PLANNER_USAGE_RETENTION_DAYS=90
CELERY_TASK_ALWAYS_EAGER=False
